// Exemplo de estrutura de arquivos para integração no frontend

/**
 * lib/stripe-client.ts
 * Cliente Stripe para o frontend
 */

import { loadStripe, Stripe } from '@stripe/stripe-js'

let stripePromise: Promise<Stripe | null> | null = null

export const getStripeClient = async (): Promise<Stripe | null> => {
  if (!stripePromise) {
    try {
      // Busca a chave pública do backend
      const response = await fetch(`${process.env.NEXT_PUBLIC_API_URL}/stripe/config`)
      const { publishableKey } = await response.json()
      
      stripePromise = loadStripe(publishableKey, {
        locale: 'pt-BR',
      })
    } catch (error) {
      console.error('Erro ao carregar Stripe:', error)
      return null
    }
  }
  
  return stripePromise
}

/**
 * hooks/useSubscription.ts
 * Hook para gerenciar assinatura
 */

import { useState, useEffect } from 'react'

interface Subscription {
  id: string
  status: string
  plan: {
    name: string
    price: string
  }
  current_period_end: string
}

export function useSubscription(organizationId: string) {
  const [subscription, setSubscription] = useState<Subscription | null>(null)
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)

  useEffect(() => {
    if (!organizationId) return

    fetch(`${process.env.NEXT_PUBLIC_API_URL}/organizations/${organizationId}/subscription`, {
      headers: {
        'Authorization': `Bearer ${getToken()}`, // Implementar getToken()
      },
    })
      .then(res => res.json())
      .then(data => {
        setSubscription(data.subscription)
        setLoading(false)
      })
      .catch(err => {
        setError(err.message)
        setLoading(false)
      })
  }, [organizationId])

  return { subscription, loading, error }
}

/**
 * hooks/usePlans.ts
 * Hook para buscar planos disponíveis
 */

import { useState, useEffect } from 'react'

interface Plan {
  id: string
  name: string
  slug: string
  description: string
  price: string
  interval: string
  trial_days: number
  features: string[]
  max_members: number | null
  max_units: number | null
  max_demands: number | null
  max_storage_gb: number | null
}

export function usePlans() {
  const [plans, setPlans] = useState<Plan[]>([])
  const [loading, setLoading] = useState(true)

  useEffect(() => {
    fetch(`${process.env.NEXT_PUBLIC_API_URL}/plans`)
      .then(res => res.json())
      .then(data => {
        setPlans(data.plans)
        setLoading(false)
      })
      .catch(() => setLoading(false))
  }, [])

  return { plans, loading }
}

/**
 * components/stripe/PaymentForm.tsx
 * Formulário de pagamento com Stripe Elements
 */

'use client'

import React, { useState } from 'react'
import {
  PaymentElement,
  useStripe,
  useElements,
} from '@stripe/react-stripe-js'

interface PaymentFormProps {
  onSuccess: () => void
  onError: (error: string) => void
}

export function PaymentForm({ onSuccess, onError }: PaymentFormProps) {
  const stripe = useStripe()
  const elements = useElements()
  const [loading, setLoading] = useState(false)

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()

    if (!stripe || !elements) {
      return
    }

    setLoading(true)

    try {
      const { error } = await stripe.confirmPayment({
        elements,
        confirmParams: {
          return_url: `${window.location.origin}/subscription/success`,
        },
      })

      if (error) {
        onError(error.message || 'Erro ao processar pagamento')
      } else {
        onSuccess()
      }
    } catch (err) {
      onError('Erro inesperado')
    } finally {
      setLoading(false)
    }
  }

  return (
    <form onSubmit={handleSubmit} className="space-y-6">
      <PaymentElement
        options={{
          layout: 'tabs',
          defaultValues: {
            billingDetails: {
              address: {
                country: 'BR',
              },
            },
          },
        }}
      />
      
      <button
        type="submit"
        disabled={!stripe || loading}
        className="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-lg disabled:opacity-50"
      >
        {loading ? (
          <span className="flex items-center justify-center">
            <svg className="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
              <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            Processando...
          </span>
        ) : (
          'Confirmar Pagamento'
        )}
      </button>
    </form>
  )
}

/**
 * components/stripe/SetupPaymentMethod.tsx
 * Componente para adicionar método de pagamento
 */

'use client'

import React, { useState, useEffect } from 'react'
import { Elements } from '@stripe/react-stripe-js'
import { getStripeClient } from '@/lib/stripe-client'
import { PaymentForm } from './PaymentForm'

interface SetupPaymentMethodProps {
  organizationId: string
  onSuccess: () => void
}

export function SetupPaymentMethod({ 
  organizationId, 
  onSuccess 
}: SetupPaymentMethodProps) {
  const [clientSecret, setClientSecret] = useState<string | null>(null)
  const [error, setError] = useState<string | null>(null)

  useEffect(() => {
    // Cria SetupIntent
    fetch(`${process.env.NEXT_PUBLIC_API_URL}/stripe/setup-intent`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${getToken()}`,
      },
      body: JSON.stringify({ organization_id: organizationId }),
    })
      .then(res => res.json())
      .then(data => setClientSecret(data.client_secret))
      .catch(err => setError('Erro ao inicializar'))
  }, [organizationId])

  if (error) {
    return <div className="text-red-500">{error}</div>
  }

  if (!clientSecret) {
    return <div className="animate-pulse">Carregando...</div>
  }

  return (
    <Elements
      stripe={getStripeClient()}
      options={{
        clientSecret,
        appearance: {
          theme: 'stripe',
          variables: {
            colorPrimary: '#2563eb',
          },
        },
        locale: 'pt-BR',
      }}
    >
      <PaymentForm
        onSuccess={onSuccess}
        onError={setError}
      />
    </Elements>
  )
}

/**
 * components/PlanCard.tsx
 * Card de plano com botão de assinatura
 */

'use client'

import React from 'react'

interface Plan {
  id: string
  name: string
  description: string
  price: string
  interval: string
  trial_days: number
  features: string[]
}

interface PlanCardProps {
  plan: Plan
  onSubscribe: (planId: string) => void
  loading?: boolean
  isCurrentPlan?: boolean
}

export function PlanCard({ 
  plan, 
  onSubscribe, 
  loading = false,
  isCurrentPlan = false 
}: PlanCardProps) {
  const intervalLabel = {
    monthly: 'mês',
    quarterly: 'trimestre',
    yearly: 'ano',
  }

  return (
    <div className={`border rounded-lg p-6 ${isCurrentPlan ? 'ring-2 ring-blue-500' : ''}`}>
      {isCurrentPlan && (
        <span className="inline-block bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded mb-2">
          Plano Atual
        </span>
      )}
      
      <h3 className="text-2xl font-bold">{plan.name}</h3>
      <p className="text-gray-600 mt-2">{plan.description}</p>
      
      <div className="mt-4">
        <span className="text-4xl font-bold">
          R$ {parseFloat(plan.price).toFixed(2)}
        </span>
        <span className="text-gray-500">
          /{intervalLabel[plan.interval as keyof typeof intervalLabel] || 'mês'}
        </span>
      </div>

      {plan.trial_days > 0 && (
        <p className="text-sm text-green-600 mt-2">
          ✓ {plan.trial_days} dias de teste grátis
        </p>
      )}

      <ul className="mt-6 space-y-3">
        {plan.features.map((feature, idx) => (
          <li key={idx} className="flex items-start text-sm">
            <svg className="w-5 h-5 text-green-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fillRule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clipRule="evenodd" />
            </svg>
            {feature}
          </li>
        ))}
      </ul>

      <button
        onClick={() => onSubscribe(plan.id)}
        disabled={loading || isCurrentPlan}
        className={`w-full mt-6 py-3 rounded-lg font-semibold transition-colors ${
          isCurrentPlan
            ? 'bg-gray-300 text-gray-600 cursor-not-allowed'
            : 'bg-blue-600 hover:bg-blue-700 text-white'
        }`}
      >
        {loading ? 'Processando...' : isCurrentPlan ? 'Plano Atual' : 'Assinar'}
      </button>
    </div>
  )
}

