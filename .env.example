# Configuração do ambiente
NODE_ENV=development

# Servidor
PORT=3333

# Banco de dados
DATABASE_URL=postgresql://docker:docker@localhost:5432/agents

# JWT (use um secret de pelo menos 32 caracteres em produção)
JWT_SECRET=your-super-secret-jwt-key-with-at-least-32-characters
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS S3
AWS_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1

# Upload limits
MAX_FILE_SIZE=10485760
MAX_FILES_PER_UPLOAD=5

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_CLIENT_REDIRECT_URI=http://localhost:3000/auth/callback

# Stripe Payment Configuration
# Obtenha suas chaves em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# Configure webhook em: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

